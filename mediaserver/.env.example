# ─────────────────────────────────────────────────────────────
#  Cloud-Herrington-style media automation — your settings
#  Copy this file to ".env" and edit the values, then run:
#     docker compose up -d
# ─────────────────────────────────────────────────────────────

# The spare 4TB drive, as Windows sees it, plus a folder name.
# Everything the automation touches (downloads + new media) lives here.
# Example: if the 4TB is drive F:, use  F:/MediaStack
DATA_DIR=F:/MediaStack

# Your timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# ── PIA VPN (qBittorrent routes through this) ──
# Your Private Internet Access login (the account user/pass, e.g. p1234567).
PIA_USER=your_pia_username
PIA_PASS=your_pia_password
# Pick a region that supports PORT FORWARDING (most US regions do NOT).
# Good ones: "CA Toronto", "CA Montreal", "Switzerland", "Romania", "Netherlands".
PIA_REGION=CA Toronto

# Leave these as-is unless you know you need to change them.
PUID=1000
PGID=1000
