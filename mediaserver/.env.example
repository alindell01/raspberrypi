# ─────────────────────────────────────────────────────────────
#  Cloud-Herrington-style media automation — your settings
#  Copy this file to ".env" and edit the values, then run:
#     docker compose up -d
# ─────────────────────────────────────────────────────────────

# The drive Docker uses for downloads + the media Radarr/Sonarr/Lidarr manage.
#
# *** USE AN INTERNAL (SATA/NVMe) DRIVE. NOT A USB DRIVE. ***
# Docker Desktop's WSL2 engine loses the mount on USB drives under write load
# (you'll see "No such device" and torrents stuck "Errored"). An internal drive
# is rock solid. Big USB drives are fine for your Plex *library* (Plex reads
# them natively) - just don't point DATA_DIR at one.
# Check a drive's type:  Get-Disk | Select FriendlyName, BusType
#
# Example: internal drive G:  ->  G:/MediaStack
DATA_DIR=G:/MediaStack

# Your timezone (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/New_York

# ── PIA VPN (qBittorrent routes through this) ──
# Your Private Internet Access login (the account user/pass, e.g. p1234567).
PIA_USER=your_pia_username
PIA_PASS=your_pia_password
# Pick a region that supports PORT FORWARDING (most US regions do NOT).
# Good ones: "CA Toronto", "CA Montreal", "Switzerland", "Romania", "Netherlands".
PIA_REGION=CA Toronto

# Leave these as-is unless you know you need to change them.
PUID=1000
PGID=1000
